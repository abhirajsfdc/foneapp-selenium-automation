BASE_URL=https://admin.foneapp.com

# Country code — use the 2-letter code (IN, US, GB, DE, FR, JP)
LOGIN_COUNTRY=IN

# Phone number digits ONLY — no +, no country code, no spaces
# Example for India +91 8958244742  →  LOGIN_PHONE=8958244742
LOGIN_PHONE=8958244742

LOGIN_PASSWORD=your_password_here
TOTP_SECRET=YOUR_BASE32_TOTP_SECRET_HERE
HEADLESS=false
BROWSER=chrome
IMPLICIT_WAIT=10
PAGE_LOAD_TIMEOUT=30
